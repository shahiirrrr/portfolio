---
/**
 * Filter / option chip (Figma: Filter Chip — Default / Active).
 *  - `as="button"`: a toggle button; active state is `aria-pressed="true"`.
 *  - `as="checkbox" | "radio"`: a form option; active state is `:checked`.
 */
interface Props {
  label: string;
  as?: 'button' | 'checkbox' | 'radio';
  active?: boolean;
  /** Form field name (checkbox / radio). */
  name?: string;
  /** Form value, or the filter value exposed as `data-value` on buttons. */
  value?: string;
}

const { label, as = 'button', active = false, name, value = label } = Astro.props;
---

{as === 'button' ? (
  <button class="chip" type="button" aria-pressed={active ? 'true' : 'false'} data-value={value}>
    {label}
  </button>
) : (
  <label class="chip">
    <input class="visually-hidden" type={as} name={name} value={value} checked={active} />
    {label}
  </label>
)}

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    white-space: nowrap;
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 var(--border-width) var(--color-border-strong);
    transition:
      color var(--duration-fast) ease-out,
      background-color var(--duration-fast) ease-out,
      box-shadow var(--duration-fast) ease-out;
  }

  @media (hover: hover) {
    .chip:hover {
      box-shadow: inset 0 0 0 var(--border-width) var(--color-text-secondary);
    }
  }

  .chip[aria-pressed='true'],
  .chip:has(:checked) {
    color: var(--color-text-inverse);
    background-color: var(--color-accent);
    box-shadow: none;
  }

  .chip:has(:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (max-width: 47.99em) {
    .chip {
      min-height: var(--tap-min);
    }
  }
</style>
