---
/**
 * Experience card (Figma: Experience Card): artwork, period pill, company and
 * role. Hover: the arrow rotates 45°. (The component note also mentions lifting a
 * desaturation on hover, but the final frames show the artwork at full colour
 * at rest — the Synnefo logo is orange — so no filter is applied.)
 */
import { Image } from 'astro:assets';

import arrowDark from '@/assets/icons/arrow-up-right-dark.svg';
import type { ExperienceItem } from '@/types';

interface Props {
  item: ExperienceItem & { image: ImageMetadata };
}

const { item } = Astro.props;
---

<article class="xp-card" data-reveal-item>
  <Image
    class="xp-card__image"
    src={item.image}
    alt=""
    widths={[290, 420, 580, 840]}
    sizes="(min-width: 48em) 30vw, 290px"
  />
  <div class="xp-card__content">
    <div class="xp-card__top">
      <p class="xp-card__period text-mono">{item.periodShort}</p>
      <span class="xp-card__arrow">
        <img src={arrowDark.src} width="16" height="16" alt="" />
      </span>
    </div>
    <div class="xp-card__bottom">
      <h3 class="text-h3">
        <span class="mobile-only">{item.shortName}</span>
        <span class="desktop-only">{item.company}</span>
      </h3>
      <p class="text-body-sm">
        {item.role} · {item.location}
      </p>
    </div>
  </div>
</article>

<style>
  .xp-card {
    position: relative;
    flex: 0 0 min(85%, 290px);
    height: 380px;
    overflow: hidden;
    border-radius: var(--radius-card);
    scroll-snap-align: start;
  }

  .xp-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legibility gradient. */
  .xp-card::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(to bottom, rgb(10 10 10 / 0) 35%, var(--color-scrim));
  }

  .xp-card__content {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-6);
  }

  .xp-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .xp-card__period {
    white-space: nowrap;
    padding: var(--space-2) 14px;
    background-color: var(--color-overlay);
    border-radius: var(--radius-full);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .xp-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-circle);
    height: var(--icon-circle);
    background-color: var(--color-text);
    border-radius: var(--radius-full);
    transition: rotate var(--duration-base) var(--ease-out);
  }

  .xp-card__bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (hover: hover) {
    .xp-card:hover .xp-card__arrow {
      rotate: 45deg;
    }
  }

  @media (min-width: 48em) {
    .xp-card {
      flex-basis: 340px;
      height: 440px;
    }
  }

  /* Three across from 1024px; narrower screens keep the swipe rail. */
  @media (min-width: 64em) {
    .xp-card {
      flex: 1 1 0;
      min-width: 0;
    }
  }
</style>
