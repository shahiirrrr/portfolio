---
/**
 * Experience card (Figma: Experience Card): artwork, company, role and period
 * (moved from the top pill to the foot at the owner's request). Hover: the
 * arrow rotates 45°. (The component note also mentions lifting a desaturation
 * on hover, but the final frames show the artwork at full colour
 * at rest — the Synnefo logo is orange — so no filter is applied.)
 * Owner-requested addition (CSS only): on hover a glossy diagonal sheen sweeps
 * across the card once, and the artwork zooms slightly.
 */
import { Image } from 'astro:assets';

import arrowDark from '@/assets/icons/arrow-up-right-dark.svg';
import arrowLight from '@/assets/icons/arrow-up-right-light.svg';
import type { ExperienceItem } from '@/types';

interface Props {
  item: ExperienceItem & { image: ImageMetadata };
}

const { item } = Astro.props;
const isLight = item.cardTheme === 'light';
const arrow = isLight ? arrowLight : arrowDark;
---

<article class:list={['xp-card', { 'xp-card--light': isLight }]} data-reveal-item data-xp-card>
  <Image
    class="xp-card__image"
    src={item.image}
    alt=""
    widths={[290, 420, 580, 840]}
    sizes="(min-width: 80em) 22vw, (min-width: 48em) 340px, 290px"
  />
  <div class="xp-card__content">
    <div class="xp-card__top">
      <span class="xp-card__arrow">
        <img src={arrow.src} width="16" height="16" alt="" />
      </span>
    </div>
    <div class="xp-card__bottom">
      <h3 class="text-h4">
        {item.url ? (
          <a class="xp-card__link" href={item.url} target="_blank" rel="noopener">
            <span class="mobile-only">{item.shortName}</span>
            <span class="desktop-only">{item.company}</span>
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        ) : (
          <>
            <span class="mobile-only">{item.shortName}</span>
            <span class="desktop-only">{item.company}</span>
          </>
        )}
      </h3>
      <p class="text-body-sm">
        {item.role} · {item.location}
      </p>
      <p class="xp-card__period text-mono">{item.periodShort}</p>
    </div>
  </div>
  <span class="xp-card__sheen" aria-hidden="true"></span>
</article>

<style>
  .xp-card {
    position: relative;
    flex: 0 0 min(85%, 290px);
    height: 380px;
    overflow: hidden;
    border-radius: var(--radius-card);
    scroll-snap-align: start;
  }

  .xp-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--duration-slow) var(--ease-out);
  }

  /* Legibility gradient. */
  .xp-card::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(to bottom, rgb(10 10 10 / 0) 35%, var(--color-scrim));
  }

  /*
   * Hover sheen: a diagonal band of light, parked off the left edge, that
   * sweeps across once per hover. It sits over the text like a reflection on
   * glass. Light artwork gets a faint shadow either side of the band so the
   * gloss still reads on white.
   */
  .xp-card__sheen {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    pointer-events: none;
    background: linear-gradient(105deg, transparent 30%, var(--color-sheen) 50%, transparent 70%);
    translate: -100% 0;
  }

  .xp-card--light .xp-card__sheen {
    background: linear-gradient(
      105deg,
      transparent 25%,
      var(--color-sheen-shadow) 40%,
      var(--color-sheen) 50%,
      var(--color-sheen-shadow) 60%,
      transparent 75%
    );
  }

  @keyframes xp-card-sheen {
    to {
      translate: 100% 0;
    }
  }

  .xp-card__content {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-6);
  }

  .xp-card__top {
    display: flex;
    justify-content: flex-end;
  }

  .xp-card__period {
    margin-block-start: var(--space-1);
    color: var(--color-text-secondary);
  }

  .xp-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-circle);
    height: var(--icon-circle);
    background-color: var(--color-text);
    border-radius: var(--radius-full);
    transition: rotate var(--duration-base) var(--ease-out);
  }

  /* Stretched link: the whole card is clickable; the focus ring outlines the card. */
  .xp-card__link {
    color: inherit;
    text-decoration: none;
  }

  .xp-card__link::after {
    position: absolute;
    inset: 0;
    content: '';
    border-radius: var(--radius-card);
  }

  .xp-card__link:focus-visible {
    outline: none;
  }

  .xp-card__link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  /* Light artwork: dark arrow button so it stays visible. */
  .xp-card--light .xp-card__arrow {
    background-color: var(--color-text-inverse);
  }

  .xp-card__bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (hover: hover) {
    .xp-card:hover .xp-card__arrow {
      rotate: 45deg;
    }

    .xp-card:hover .xp-card__image {
      scale: 1.03;
    }

    .xp-card:hover .xp-card__sheen {
      animation: xp-card-sheen var(--duration-sheen) var(--ease-in-out);
    }
  }

  /* Desktop: stretches to the rail height set by AboutIntro (340–440px). */
  @media (min-width: 48em) {
    .xp-card {
      flex-basis: 340px;
      height: auto;
    }
  }

  /* Four across from 1280px; narrower screens keep the swipe rail. */
  @media (min-width: 80em) {
    .xp-card {
      flex: 1 1 0;
      min-width: 0;
    }
  }
</style>
