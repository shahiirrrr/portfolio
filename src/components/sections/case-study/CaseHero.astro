---
/**
 * Case study hero: the project image fills the whole screen with the title over it
 * (owner-approved redesign of Figma "01 Hero" + "02 Cover", built for the Home
 * card transition). It shows the Home card's image, so the transition lands on
 * the same picture; it is the page's LCP image.
 *
 * Arriving from a Home card, the card's full-screen frame hands over to it in
 * place (CardStage + case-study-enter.ts). Scrolling, the hero
 * recedes into a rounded panel while the image drifts and the title lifts away
 * (case-study-hero.ts).
 */
import { getImage, Image } from 'astro:assets';

import CardStage from '@/components/ui/CardStage.astro';

interface Cover {
  src: ImageMetadata;
  /** Optional tighter crop used below 768px. */
  srcMobile?: ImageMetadata | undefined;
  alt: string;
}

interface Props {
  title: string;
  cover?: Cover | undefined;
}

const { title, cover } = Astro.props;
const mobile = cover?.srcMobile
  ? await getImage({ src: cover.srcMobile, widths: [390, 780, cover.srcMobile.width] })
  : undefined;
---

<header class="cs-hero" data-cs-hero data-header-hero>
  <div class="cs-hero__panel" data-cs-cover>
    <div class="cs-hero__media" data-cs-media>
      {cover && (
        <picture>
          {mobile && (
            <source media="(max-width: 47.99em)" srcset={mobile.srcSet.attribute} sizes="100vw" />
          )}
          <Image
            class="cs-hero__image"
            src={cover.src}
            alt={cover.alt}
            widths={[480, 800, 1200, 1600, 2400, cover.src.width]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      )}
    </div>

    <div class="cs-hero__content" data-cs-hero-content>
      <h1 class="cs-hero__title" data-line-reveal="load" data-intro>
        {title}
      </h1>
    </div>
  </div>
</header>

<CardStage mode="enter" />

<script>
  import { initCaseStudyEnter } from '@/scripts/animations/case-study-enter';
  import { initCaseStudyHero } from '@/scripts/animations/case-study-hero';

  const hero = document.querySelector<HTMLElement>('[data-cs-hero]');
  const stage = document.querySelector<HTMLElement>('[data-card-stage="enter"]');
  const panel = hero?.querySelector<HTMLElement>('[data-cs-cover]');

  if (hero) initCaseStudyHero(hero);
  if (stage && panel) initCaseStudyEnter(stage, panel);
</script>

<style>
  .cs-hero {
    /* Mobile/Display 76px at 390 (scales down on narrower screens) → Display/XL 176px at 1440. */
    --cs-title-size: min(19.487vw, clamp(4.75rem, 2.429rem + 9.524vw, 11rem));

    height: 100svh;
    min-height: 480px; /* one-off: keeps the title clear of the header on landscape phones */
  }

  /* Full-bleed at rest; the scroll effect rounds its corners as it recedes. */
  .cs-hero__panel {
    position: relative;
    height: 100%;
    background-color: var(--color-bg-raised);
    overflow: hidden;
    /* 0 at rest (square, full-bleed) → 1 when scrolled away (case-study-hero.ts). */
    border-radius: calc(var(--radius-panel) * var(--cs-hero-round, 0));
    transform-origin: 50% 100%;
  }

  /* Image + legibility gradient move as one layer (the scroll drift), so the
     panel's clipped edge always shows gradient-darkened image: drifting the
     image alone left a bright 1px row at the panel's bottom edge in Chromium. */
  .cs-hero__media {
    position: absolute;
    inset: 0;
  }

  .cs-hero__media picture {
    display: contents;
  }

  .cs-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legibility: a light shade under the header, a deep one under the title. */
  .cs-hero__media::after {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(to bottom, var(--color-overlay), transparent 28%),
      linear-gradient(to top, var(--color-scrim), transparent 60%);
  }

  .cs-hero__content {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* The title lines up with the page container. */
    padding: var(--header-offset) var(--container-gutter) var(--container-gutter);
  }

  .cs-hero__title {
    font-size: var(--cs-title-size);
    font-weight: var(--weight-bold);
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--color-text);
  }

  /* SplitText line masks clip at the line box; give descenders ("Yoga") room. */
  .cs-hero__title > :global(*) {
    padding-block-end: 0.12em;
    margin-block-end: -0.12em;
  }

  @media (min-width: 48em) {
    .cs-hero__title {
      line-height: var(--leading-display);
      letter-spacing: var(--tracking-display);
    }
  }
</style>
