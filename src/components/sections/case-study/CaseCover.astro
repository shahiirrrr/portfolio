---
/**
 * Large cover image panel (Figma: 02 Cover). The LCP element of a case study.
 * An optional `srcMobile` crop replaces the image below 768px, as in the mobile frame.
 */
import { getImage, Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  srcMobile?: ImageMetadata | undefined;
  alt: string;
}

const { src, srcMobile, alt } = Astro.props;
const mobile = srcMobile
  ? await getImage({ src: srcMobile, widths: [390, 780, srcMobile.width] })
  : undefined;
---

<div class="cs-cover">
  <div class="cs-cover__frame" data-cs-cover>
    <picture>
      {mobile && (
        <source
          media="(max-width: 47.99em)"
          srcset={mobile.srcSet.attribute}
          sizes="calc(100vw - 24px)"
        />
      )}
      <Image
        src={src}
        alt={alt}
        widths={[480, 800, 1200, 1600, 2400, src.width]}
        sizes="(min-width: 90em) 1400px, 96vw"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
  </div>
</div>

<script>
  import { initCaseStudyCover } from '@/scripts/animations/case-study-cover';

  document.querySelectorAll<HTMLElement>('[data-cs-cover]').forEach(initCaseStudyCover);
</script>

<style>
  .cs-cover {
    padding-inline: var(--panel-gutter);
  }

  .cs-cover__frame {
    height: 440px;
    max-width: 1400px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-panel);
  }

  .cs-cover__frame picture {
    display: contents;
  }

  .cs-cover__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 48em) {
    .cs-cover__frame {
      height: auto;
      max-height: 760px;
      aspect-ratio: 1400 / 760;
    }
  }
</style>
