---
/**
 * Case study intro under the full-screen hero: the subtitle and the
 * ROLE / STACK / TIMELINE / LIVE facts (Figma "01 Hero" content, moved below
 * the cover for the card transition). Only facts that exist are rendered.
 * Both rise in as they scroll into view. The stack shows as icons (owner
 * decision); a technology without an icon falls back to its name.
 */
import type { TechItem } from '@/types';

interface MetaItem {
  label: string;
  value?: string;
  /** External URL: the value becomes a link that opens in a new tab. */
  href?: string;
  /** Rendered as a row of icons instead of `value`. */
  tech?: TechItem[];
}

interface Props {
  subtitle?: string | undefined;
  meta: MetaItem[];
}

const { subtitle, meta } = Astro.props;
---

<section class="cs-intro container" aria-label="Project summary">
  {subtitle && (
    <p class="cs-intro__subtitle text-h2" data-reveal>
      {subtitle}
    </p>
  )}

  {meta.length > 0 && (
    <dl class="cs-intro__meta" data-reveal-group data-y="20" data-stagger="0.06">
      {meta.map((item) => (
        <div class="cs-intro__meta-item" data-reveal-item>
          <dt class="text-mono">{item.label}</dt>
          <dd class="text-h4">
            {item.tech && (
              <ul class="cs-intro__tech" role="list">
                {item.tech.map((tool) => (
                  <li>
                    {tool.icon ? (
                      <img
                        class="cs-intro__tech-icon"
                        src={tool.icon.src}
                        width="28"
                        height="28"
                        alt={tool.name}
                        title={tool.name}
                      />
                    ) : (
                      tool.name
                    )}
                  </li>
                ))}
              </ul>
            )}
            {item.href && (
              <a class="cs-intro__live" href={item.href} target="_blank" rel="noopener">
                {item.value}{' '}
                <span class="cs-intro__live-arrow" aria-hidden="true">
                  &#x2197;&#xFE0E;
                </span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )}
            {!item.tech && !item.href && item.value}
          </dd>
        </div>
      ))}
    </dl>
  )}
</section>

<style>
  .cs-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-14) var(--space-10);
  }

  .cs-intro__subtitle {
    line-height: 1.12;
  }

  .cs-intro__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
  }

  .cs-intro__meta-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cs-intro__meta-item dt {
    color: var(--color-text-muted);
  }

  .cs-intro__meta-item dd {
    overflow-wrap: break-word;
  }

  .cs-intro__tech {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  /* Figma tech glyphs are drawn at 24–32px; show them all in one 28px box. */
  .cs-intro__tech-icon {
    display: block;
    inline-size: 28px;
    block-size: 28px;
    object-fit: contain;
  }

  .cs-intro__live {
    text-decoration: underline transparent;
    transition: text-decoration-color var(--duration-fast) ease-out;
  }

  .cs-intro__live-arrow {
    font-variant-emoji: text;
  }

  .cs-intro__live:focus-visible {
    text-decoration-color: currentcolor;
  }

  @media (hover: hover) {
    .cs-intro__live:hover {
      text-decoration-color: currentcolor;
    }
  }

  @media (min-width: 48em) {
    .cs-intro {
      gap: var(--space-10);
      padding-block: 104px var(--space-18);
    }

    .cs-intro__subtitle {
      max-width: 1000px;
      line-height: var(--leading-tight);
    }

    .cs-intro__meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
