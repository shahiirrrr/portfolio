---
/**
 * One project in the Work list (Figma: Work Row — Desktop / Mobile, Default / Hover).
 * Rows with a case study are one link (stretched over the row); rows without
 * one render the same visuals as plain content.
 * In the desktop grid view the same markup becomes a card (see WorkList).
 */
import { Image } from 'astro:assets';

import arrowDark from '@/assets/icons/arrow-up-right-dark.svg';
import arrowMuted from '@/assets/icons/arrow-up-right-muted.svg';
import { padIndex } from '@/utils/helpers';

interface Props {
  index: number;
  title: string;
  stack: string;
  year?: number;
  href?: string;
  thumbnail?: ImageMetadata;
  /** Space-separated filter tags this project matches. */
  tags: string;
}

const { index, title, stack, year, href, thumbnail, tags } = Astro.props;
---

<li class="work-item" data-work-item data-tags={tags} data-reveal-item>
  <article class:list={['work-row', { 'work-row--link': href }]}>
    <p class="work-row__index text-mono">{padIndex(index)}</p>
    <h3 class="work-row__title">
      {href ? (
        <a class="work-row__link" href={href}>
          {title}
        </a>
      ) : (
        title
      )}
    </h3>
    <p class="work-row__stack">{stack}</p>
    <p class="work-row__year text-mono">{year ?? '—'}</p>
    <span class="work-row__arrow" aria-hidden="true">
      <img class="work-row__arrow-icon" src={arrowMuted.src} width="16" height="16" alt="" />
      <img
        class="work-row__arrow-icon work-row__arrow-icon--hover"
        src={arrowDark.src}
        width="16"
        height="16"
        alt=""
      />
    </span>
    {thumbnail ? (
      <div class="work-row__thumb">
        <Image src={thumbnail} alt="" widths={[320, 640, 880]} sizes="440px" />
      </div>
    ) : (
      <div class="work-row__thumb work-row__thumb--empty" />
    )}
  </article>
</li>

<style>
  .work-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'index year'
      'title title'
      'stack stack';
    row-gap: 10px;
    padding-block: var(--space-6);
    border-block-start: var(--border-strong);
    transition:
      opacity var(--duration-base) ease-out,
      border-color var(--duration-base) ease-out;
  }

  .work-row__index {
    grid-area: index;
    color: var(--color-text-muted);
    transition: color var(--duration-base) ease-out;
  }

  .work-row__title {
    grid-area: title;
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: 1.12;
    letter-spacing: var(--tracking-h2);
    color: var(--color-text);
  }

  .work-row__link::after {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    content: '';
  }

  .work-row__link:focus-visible {
    outline: none;
  }

  .work-row:has(.work-row__link:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .work-row__stack {
    grid-area: stack;
    font-size: var(--text-sm);
    line-height: var(--leading-body-sm);
    color: var(--color-text-secondary);
  }

  .work-row__year {
    grid-area: year;
    justify-self: end;
    white-space: nowrap;
    color: var(--color-text-secondary);
  }

  .work-row__arrow,
  .work-row__thumb {
    display: none;
  }

  @media (min-width: 48em) {
    .work-row {
      grid-template-columns: var(--space-12) minmax(0, 1fr) clamp(10rem, 23vw, 18.75rem) auto var(
          --space-12
        );
      grid-template-areas: 'index title stack year arrow';
      align-items: center;
      column-gap: clamp(var(--space-4), 2.22vw, var(--space-8));
      padding-block: calc(var(--space-8) + var(--space-1));
    }

    .work-row__title {
      line-height: var(--leading-tight);
    }

    .work-row__arrow {
      position: relative;
      display: grid;
      place-items: center;
      grid-area: arrow;
      width: var(--space-12);
      height: var(--space-12);
      border-radius: var(--radius-full);
      box-shadow: inset 0 0 0 var(--border-width) var(--color-border-strong);
      transition:
        background-color var(--duration-base) ease-out,
        box-shadow var(--duration-base) ease-out;
    }

    .work-row__arrow-icon {
      grid-area: 1 / 1;
    }

    .work-row__arrow-icon--hover {
      opacity: 0;
    }

    /* Hover preview (Figma: Work Row / State=Hover). */
    .work-row__thumb {
      position: absolute;
      inset-block-start: -50px;
      inset-inline-start: 33%;
      z-index: var(--z-raised);
      display: block;
      width: 320px;
      height: 220px;
      overflow: hidden;
      pointer-events: none;
      border-radius: var(--radius-media);
      box-shadow: var(--shadow-float);
      opacity: 0;
      rotate: 4deg;
      scale: 0.92;
      transition:
        opacity var(--duration-medium),
        scale var(--duration-medium) var(--ease-out);
    }

    .work-row__thumb--empty {
      display: none;
    }

    .work-row__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (min-width: 48em) and (hover: hover) {
    .work-row:hover,
    .work-row:has(:focus-visible) {
      border-block-start-color: var(--color-accent);
    }

    .work-row:hover .work-row__index,
    .work-row:has(:focus-visible) .work-row__index {
      color: var(--color-accent);
    }

    .work-row:hover .work-row__arrow,
    .work-row:has(:focus-visible) .work-row__arrow {
      background-color: var(--color-accent);
      box-shadow: none;
    }

    .work-row:hover .work-row__arrow-icon--hover,
    .work-row:has(:focus-visible) .work-row__arrow-icon--hover {
      opacity: 1;
    }

    .work-row:hover .work-row__thumb {
      opacity: 1;
      scale: 1;
    }

    /* The other rows dim to 40% while one is hovered or focused. */
    :global(.work-list:hover) .work-row,
    :global(.work-list:has(:focus-visible)) .work-row {
      opacity: 0.4;
    }

    :global(.work-list:hover) .work-row:hover,
    :global(.work-list:has(:focus-visible)) .work-row:has(:focus-visible) {
      opacity: 1;
    }
  }

  /* Grid view (desktop only): the same row becomes a card — thumbnail on top,
     then number / year, title and stack. No Figma frame exists for it. */
  @media (min-width: 48em) {
    :global(.work-list[data-view='grid']) .work-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'thumb thumb'
        'index year'
        'title title'
        'stack stack';
      align-items: start;
      row-gap: var(--space-3);
      padding-block: 0;
      border-block-start: 0;
    }

    :global(.work-list[data-view='grid']) .work-row__arrow {
      display: none;
    }

    :global(.work-list[data-view='grid']) .work-row__thumb {
      position: static;
      grid-area: thumb;
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      margin-block-end: var(--space-2);
      background-color: var(--color-bg-raised);
      border-radius: var(--radius-card);
      box-shadow: none;
      opacity: 1;
      rotate: 0deg;
      scale: 1;
    }

    :global(.work-list[data-view='grid']) .work-row__title {
      font-size: var(--text-2xl);
      line-height: var(--leading-snug);
      letter-spacing: var(--tracking-h3);
    }
  }
</style>
