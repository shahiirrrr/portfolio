---
/**
 * Home process section (Figma: Process Dial / Desktop + Mobile).
 *
 * Baseline (no JS, or prefers-reduced-motion): a plain numbered list of steps.
 * Enhanced (`.is-enhanced`, set by the script): the section pins while the
 * user scrolls; progress rotates the dial one notch per step, snaps to each
 * step, rolls the big numeral like an odometer (one reel per digit) and swaps
 * the step copy and the right-hand index.
 *
 * Desktop: the dial fills the left side top to bottom; the heading sits on the
 * right, above the step copy.
 *
 * Geometry is expressed in design pixels × `--u`, relative to the dial centre
 * (`--cx`, `--cy`), so the composition scales with the viewport.
 */
import activeDot from '@/assets/images/dial/active-dot.svg';
import dot from '@/assets/images/dial/dot.svg';
import glow from '@/assets/images/dial/glow.svg';
import ringInner from '@/assets/images/dial/ring-inner.png';
import ring from '@/assets/images/dial/ring.svg';
import { PROCESS_STEPS } from '@/data/home';
import { padIndex } from '@/utils/helpers';

// One reel per digit position: reel 0 holds every step's tens digit, reel 1 the ones.
const numerals = PROCESS_STEPS.map((_, i) => padIndex(i + 1));
const reels = Array.from({ length: numerals[0]?.length ?? 0 }, (_, d) =>
  numerals.map((numeral) => numeral.charAt(d)),
);
---

<section class="process" aria-labelledby="process-heading" data-process>
  <div class="process__stage" aria-hidden="true">
    <img class="process__glow" src={glow.src} width="800" height="800" alt="" />
    <img class="process__ring" src={ring.src} width="760" height="760" alt="" />
    <img
      class="process__ring process__ring--inner desktop-only"
      src={ringInner.src}
      width="580"
      height="580"
      alt=""
      loading="lazy"
    />
    <div class="process__dial" data-process-dial>
      {PROCESS_STEPS.map((_, i) => (
        <div class="process__notch" style={`--i:${i - 2}`}>
          <img class="process__dot" src={dot.src} width="8" height="8" alt="" />
          <span class="process__notch-number" data-process-notch>
            {padIndex(i + 1)}
          </span>
        </div>
      ))}
    </div>
    <img class="process__active-dot" src={activeDot.src} width="12" height="12" alt="" />
    <span class="process__tick"></span>
    <div class="process__numerals">
      {reels.map((digits) => (
        <span class="process__reel" data-process-reel>
          {digits.map((digit) => (
            <span class="process__digit">{digit}</span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <div class="container process__heading">
    <h2 class="text-h1" id="process-heading" data-reveal>
      A five-act process, <br class="desktop-only" />
      never a template.
    </h2>
  </div>

  <ol class="process__steps" role="list">
    {PROCESS_STEPS.map(({ title, body, bodyShort }, i) => (
      <li class="process__step" data-process-step>
        <span class="process__step-number text-mono text-muted">{padIndex(i + 1)}</span>
        <h3 class="text-h3" data-process-title>
          {title}
        </h3>
        {body && (
          <p class="text-body" data-process-body>
            {bodyShort ? (
              <>
                <span class="mobile-only">{bodyShort}</span>
                <span class="desktop-only">{body}</span>
              </>
            ) : (
              body
            )}
          </p>
        )}
      </li>
    ))}
  </ol>

  <ul class="process__index desktop-only" role="list" aria-label="Process steps">
    {PROCESS_STEPS.map(({ title }, i) => (
      <li>
        <button class="process__index-item" type="button" data-process-jump>
          <span class="text-label">{title}</span>
          <span class="text-mono">{padIndex(i + 1)}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<script>
  import { initProcessDial } from '@/scripts/animations/home-process-dial';

  const section = document.querySelector<HTMLElement>('[data-process]');
  if (section) initProcessDial(section);
</script>

<style>
  /* ---------- Baseline: a numbered list ---------- */
  .process {
    position: relative;
    padding-block: var(--space-section) var(--space-10);
  }

  .process__stage,
  .process__index {
    display: none;
  }

  .process__steps {
    display: grid;
    gap: var(--space-8);
    max-width: calc(var(--container-default) + 2 * var(--container-gutter));
    margin-inline: auto;
    padding: var(--space-12) var(--container-gutter) 0;
  }

  .process__step {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    max-width: 350px;
  }

  @media (min-width: 48em) {
    .process__steps {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  /* ---------- Enhanced: pinned dial ---------- */
  .process.is-enhanced {
    /* Mobile frame: 390 wide, dial centre x -150, radius 260, 20° per step. */
    --u: min(0.25641vw, 1.3px);
    --cx: calc(-150 * var(--u));
    --cy: 50%;
    --radius: calc(260 * var(--u));
    --step-angle: 20deg;

    height: 100svh;
    min-height: 700px;
    padding: 0;
    overflow: hidden;
  }

  .is-enhanced .process__stage {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  .is-enhanced .process__heading {
    position: relative;
    padding-block-start: var(--space-section);
  }

  .process__glow,
  .process__ring,
  .process__dial,
  .process__active-dot {
    position: absolute;
    inset-block-start: var(--cy);
    max-width: none;
    translate: -50% -50%;
  }

  .process__glow {
    inset-inline-start: calc(260 * var(--u));
    width: calc(500 * var(--u));
    height: auto;
  }

  .process__ring {
    inset-inline-start: var(--cx);
    width: calc(2 * var(--radius));
    height: auto;
  }

  .process__ring--inner {
    /* 580 / 760 of the outer ring, so it scales with the full-height dial. */
    width: calc(var(--radius) * 1.526);
  }

  .process__dial {
    inset-inline-start: var(--cx);
    width: 0;
    height: 0;
    /* Step 1 rests two notches clockwise; the script scrubs it to the mirror angle. */
    rotate: calc(2 * var(--step-angle));
  }

  .process__notch {
    position: absolute;
    inset: 0 auto auto 0;
    display: flex;
    align-items: center;
    gap: calc(21 * var(--u));
    height: 0;
    rotate: calc(var(--i) * var(--step-angle));
    /* Dot centre sits on the ring. */
    translate: calc(var(--radius) - 3 * var(--u)) 0;
    transform-origin: calc(-1 * (var(--radius) - 3 * var(--u))) 50%;
  }

  .process__dot {
    width: calc(6 * var(--u));
    height: auto;
    max-width: none;
  }

  .process__notch-number,
  .process__numerals {
    font-family: var(--font-numeric);
    font-weight: var(--weight-bold);
    line-height: var(--leading-none);
  }

  .process__notch-number {
    font-size: calc(32 * var(--u));
    color: var(--color-text-muted);
    transition: opacity var(--duration-base) ease-out;
  }

  .process__notch-number.is-active {
    opacity: 0;
  }

  .process__active-dot {
    inset-inline-start: calc(var(--cx) + var(--radius));
    width: calc(10 * var(--u));
    height: auto;
  }

  /* Links the active dot to the big numeral. */
  .process__tick {
    position: absolute;
    inset-block-start: var(--cy);
    inset-inline-start: calc(122 * var(--u));
    width: calc(34 * var(--u));
    height: 1px;
    background-color: var(--color-accent);
  }

  /*
   * Odometer window: one line tall (1.5em — Antonio's digits sit low in the em
   * box and must clear the faded edges); each reel is a column of digits the
   * script slides vertically.
   */
  .process__numerals {
    position: absolute;
    inset-block-start: var(--cy);
    inset-inline-start: calc(168 * var(--u));
    display: flex;
    /* Reels keep their full height (stretching would shrink the roll distance). */
    align-items: flex-start;
    height: 1.5em;
    overflow: clip;
    font-size: calc(120 * var(--u));
    font-variant-numeric: tabular-nums;
    mask-image: linear-gradient(transparent, black 12%, black 88%, transparent);
    translate: 0 -50%;
  }

  .process__reel {
    display: flex;
    flex-direction: column;
  }

  .process__digit {
    display: block;
    height: 1.5em;
    line-height: 1.5;
  }

  .is-enhanced .process__steps {
    position: absolute;
    display: block;
    padding-block: 0;
  }

  /* Visibility of the stacked steps is driven by the script. */
  .is-enhanced .process__step {
    gap: var(--space-2);
  }

  .is-enhanced .process__step + .process__step {
    position: absolute;
    inset-block-start: 0;
  }

  .is-enhanced .process__step-number {
    display: none;
  }

  /*
   * Mobile: heading, dial and step copy stack in three rows, so nothing
   * overlaps at any phone height. The dial is centred in the middle row and
   * dissolves at the row's edges instead of running under the heading or
   * clipping at the screen edge. The steps share one grid cell, so the row is
   * as tall as the longest step and the copy never shifts.
   */
  @media (max-width: 47.99em) {
    .process.is-enhanced {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      min-height: 500px;
    }

    .is-enhanced .process__heading {
      grid-row: 1;
    }

    .is-enhanced .process__stage {
      position: relative;
      inset: auto;
      grid-row: 2;
      /* Lets the numeral scale down when short phones squeeze this row. */
      container-type: size;
      mask-image: linear-gradient(transparent, black 22%, black 78%, transparent);
    }

    .process__numerals {
      font-size: min(calc(120 * var(--u)), 40cqh);
    }

    .process__glow {
      inset-inline-start: calc(220 * var(--u));
    }

    .is-enhanced .process__steps {
      position: relative;
      inset: auto;
      grid-row: 3;
      display: grid;
      width: 100%;
      padding-block: 0 var(--space-12);
    }

    .is-enhanced .process__step,
    .is-enhanced .process__step + .process__step {
      position: static;
      grid-area: 1 / 1;
    }
  }

  @media (min-width: 48em) {
    .process.is-enhanced {
      /* Desktop frame: 1440 wide, dial centre at (40, 690), radius 380, 25° per step. */
      --u: min(0.069444vw, 1px);
      /*
       * The dial fills the left side: the radius grows with the viewport
       * height (425px = 56% of the 760px min-height), and the centre shifts
       * left so the ring's right edge stays at x 420, where the active dot,
       * tick and numeral line up.
       */
      --radius: max(calc(380 * var(--u)), 56vh, 425px);
      --cx: calc(420 * var(--u) - var(--radius));
      --step-angle: 25deg;

      height: 100vh;
      min-height: 760px;
    }

    .is-enhanced .process__stage {
      inset-inline: max(0px, (100% - 90rem) / 2);
    }

    .is-enhanced .process__heading {
      text-align: end;
    }

    .process__glow {
      inset-inline-start: calc(620 * var(--u));
      width: calc(800 * var(--u));
    }

    .process__notch {
      gap: calc(24 * var(--u));
      translate: calc(var(--radius) - 4 * var(--u)) 0;
      transform-origin: calc(-1 * (var(--radius) - 4 * var(--u))) 50%;
    }

    .process__dot {
      width: calc(8 * var(--u));
    }

    .process__notch-number {
      font-size: calc(88 * var(--u));
    }

    .process__active-dot {
      width: calc(12 * var(--u));
    }

    .process__tick {
      inset-inline-start: calc(432 * var(--u));
      width: calc(56 * var(--u));
    }

    .process__numerals {
      inset-block-start: calc(var(--cy) + 20 * var(--u));
      inset-inline-start: calc(500 * var(--u));
      font-size: calc(200 * var(--u));
    }

    .is-enhanced .process__steps {
      inset-block-start: calc(var(--cy) - 62 * var(--u));
      inset-inline: max(0px, (100% - 90rem) / 2);
      max-width: none;
      margin: 0;
      padding-inline: calc(760 * var(--u)) var(--container-gutter);
    }

    .is-enhanced .process__step {
      gap: var(--space-3);
      max-width: 340px;
    }

    .is-enhanced .process__step + .process__step {
      inset-inline-start: calc(760 * var(--u));
    }
  }

  @media (min-width: 64em) {
    .is-enhanced .process__index {
      position: absolute;
      inset-block-start: calc(var(--cy) - 78.5px);
      inset-inline-end: max(var(--container-gutter), (100% - var(--container-default)) / 2);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 18px;
    }

    .is-enhanced .process__steps {
      padding-inline-end: calc(var(--container-gutter) + 180px);
    }
  }

  .process__index-item {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-text-muted);
    transition: color var(--duration-base) ease-out;
  }

  .process__index-item[aria-current='step'] {
    color: var(--color-text);
  }

  @media (hover: hover) {
    .process__index-item:hover {
      color: var(--color-text-secondary);
    }

    .process__index-item[aria-current='step']:hover {
      color: var(--color-text);
    }
  }
</style>
