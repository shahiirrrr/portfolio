---
/**
 * Home hero (Figma: Hero — Editorial). White, fills the first screen. The giant name
 * sits BEHIND the portrait cut-out; the role and socials use mix-blend-mode:
 * difference so they read black on white and white on the hoodie or the ink.
 * Motion (home-hero.ts): the "Negative" ink canvas (owner-approved exception,
 * CLAUDE.md §13) opens the hero with a white ink drop on the dark ground, then
 * inverts what the pointer paints; the scroll flood never inverts the photo. While motion is allowed the
 * hero starts on the dark ground (`::after`) until the intro takes over.
 */
import { Image } from 'astro:assets';

import portraitMask from '@/assets/images/portrait-mask.svg';
import portrait from '@/assets/images/portrait.png';
import { SITE, SOCIAL_LINKS } from '@/config/site';
---

<section class="hero" data-hero data-header-hero>
  <h1 class="hero__name" data-hero-name-wrap>
    <span data-hero-name>{SITE.name}</span>
    <span class="visually-hidden"> — {SITE.jobTitle}, React &amp; Next.js</span>
  </h1>

  <div
    class="hero__portrait"
    style={`--mask: url("${portraitMask.src}")`}
    data-hero-portrait
    data-intro
  >
    <Image
      src={portrait}
      alt={`Portrait of ${SITE.name}, arms crossed, wearing a black hoodie`}
      widths={[440, 704, 880, 1052]}
      sizes="(min-width: 48em) 49vw, 113vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <canvas
    class="hero__ink"
    aria-hidden="true"
    data-hero-ink
    data-hero-mask={portraitMask.src}
  ></canvas>

  <ul class="hero__socials" role="list" aria-label="Social profiles" data-hero-fade data-intro>
    {SOCIAL_LINKS.map(({ label, href }) => (
      <li>
        <a href={href} target="_blank" rel="noopener">
          {label}
          <span class="hero__socials-arrow desktop-only" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
    ))}
  </ul>

  <p class="hero__role" aria-hidden="true" data-hero-fade data-intro>
    {SITE.jobTitle}
    <br />
    React &amp; Next.js
  </p>
</section>

<script>
  import { initHero } from '@/scripts/animations/home-hero';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHero(hero);
</script>

<style>
  .hero {
    /* The hero fills the first screen on every device. svh, not dvh: it equals
       the visible screen on load and never resizes while mobile browser bars
       hide/show on scroll (dvh would make the page jump). */
    --hero-h: max(100svh, 560px);
    /* Portrait box (704×880): as large as fits below the socials — its top
       stays ≥ 210px, as in the mobile frame — and never wider than the frame's
       440px at 390px (112.8vw). */
    --portrait-w: min(112.8vw, calc((var(--hero-h) - 210px) * 0.8));

    position: relative;
    isolation: isolate;
    height: var(--hero-h);
    overflow: hidden;
    color: var(--color-text-inverse);
    background-color: var(--color-bg-white);
  }

  /* The ink field (home-hero-negative.ts). Negative mode: drawn in
     white-minus-ground above the portrait, so `difference` turns the white
     ground and the name dark and the pointer trail paints the photo in
     negative; the scroll flood is kept off the photo by its silhouette (in
     the shader). Cover mode (the load intro): on top of everything, painting
     the dark ground. */
  .hero__ink {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .hero__ink[data-cover] {
    z-index: 3;
    mix-blend-mode: normal;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Start state of the develop intro: the dark ground, matching the canvas'
       first fully inked frame. Lifted when home-hero.ts marks the hero
       `data-hero-ready` (fading out if the classic intro runs instead), or by
       the CSS failsafe below if the script never runs. A hero-local marker:
       other sections set the global `motion-ready` much earlier. */
    .hero::after {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      visibility: hidden;
      content: '';
      background-color: var(--color-bg);
      opacity: 0;
      transition:
        opacity var(--duration-slow) var(--ease-out),
        visibility 0s linear var(--duration-slow);
    }

    :global(html.js) .hero:not([data-hero-ready])::after {
      visibility: visible;
      opacity: 1;
      transition: none;
      /* Same 2.5s failsafe as BaseLayout's `motion-ready`. */
      animation: hero-start-failsafe 0s linear 2.5s forwards;
    }
  }

  @keyframes hero-start-failsafe {
    to {
      visibility: hidden;
      opacity: 0;
    }
  }

  .hero__name {
    position: absolute;
    /* Anchored to the portrait (40px below its top in the 440px-wide frame:
       1.25 − 0.091 = 1.159) so the head overlaps the name at any height. */
    inset-block-start: calc(100% - var(--portrait-w) * 1.159);
    inset-inline-start: var(--space-4);
    /* Room for the letters to rise out of the mask without clipping ascenders. */
    padding-block: 0.1em;
    margin-block-start: -0.1em;
    overflow: hidden;
    font-size: clamp(120px, 33vw, 475px);
    font-weight: var(--weight-semibold);
    line-height: 0.9;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }

  .hero__name > span:first-child {
    display: inline-block;
    padding-inline-end: 0.06em;
  }

  .hero__portrait {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 50%;
    z-index: var(--z-raised);
    width: var(--portrait-w);
    aspect-ratio: 704 / 880;
    translate: -50% 0;
    /* The photo is cut out by Figma's "Silhouette Mask" vector. */
    -webkit-mask: var(--mask) no-repeat;
    mask: var(--mask) no-repeat;
    -webkit-mask-size: 85.653% 97.159%;
    mask-size: 85.653% 97.159%;
    -webkit-mask-position: calc(var(--portrait-w) * 0.06818) calc(var(--portrait-w) * 0.03551);
    mask-position: calc(var(--portrait-w) * 0.06818) calc(var(--portrait-w) * 0.03551);
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__role {
    position: absolute;
    inset-block-start: 92px;
    inset-inline-start: var(--space-5);
    z-index: 2;
    font-size: 1.875rem;
    /* Reads black on the white hero and white on the hoodie and the ink. */
    color: var(--color-bg-white);
    mix-blend-mode: difference;
    font-weight: var(--weight-semibold);
    line-height: 1.05;
    letter-spacing: var(--tracking-h1);
    white-space: nowrap;
  }

  .hero__socials {
    position: absolute;
    inset-block-start: 160px;
    inset-inline-start: var(--space-5);
    z-index: 2;
    display: flex;
    color: var(--color-bg-white);
    mix-blend-mode: difference;
    gap: 0.8em;
    font-size: var(--text-mono);
    font-weight: var(--weight-medium);
    line-height: normal;
    white-space: nowrap;
  }

  .hero__socials a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .hero__socials-arrow {
    font-family: var(--font-mono);
  }

  @media (hover: hover) {
    .hero__socials a:hover {
      text-decoration: underline;
    }
  }

  @media (min-width: 48em) {
    .hero {
      --hero-h: max(100svh, 600px);
      /* 704×880 in a 900px-tall hero, overhanging the bottom edge by 24px. */
      --portrait-w: min(48.9vw, calc((100svh - 20px) * 0.8));
    }

    .hero__name {
      inset-block-start: 27.8%;
      inset-inline-start: 3.9%;
    }

    .hero__portrait {
      inset-block-end: -24px;
      inset-inline-start: calc(50% + 2.9vw);
    }

    .hero__role {
      inset-block: auto var(--space-10);
      /* Right edge on the content gutter (x 1372 in the 1440 frame). */
      inset-inline: auto var(--container-gutter);
      font-size: clamp(1.875rem, 3.2vw, 2.875rem);
      line-height: 1.02;
    }

    .hero__socials {
      inset-block: auto var(--space-12);
      inset-inline-start: var(--container-gutter);
      flex-direction: column;
      gap: 0;
      font-size: var(--text-nav);
    }

    .hero__socials a {
      min-height: 28px;
    }
  }
</style>
