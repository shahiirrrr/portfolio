---
/**
 * "Let's build something real." call-to-action panel (Figma: 06 Contact / CTA Panel).
 * Closes the Home page (Home-only by owner decision). The headline doubles
 * as the level of the "headline runner" game (HeadlineRunner).
 */
import Button from '@/components/common/Button.astro';
import HeadlineRunner from '@/components/sections/home/HeadlineRunner.astro';
import { SITE } from '@/config/site';

// Hover: each letter rolls up and a copy rises in after it, left to right.
const emailChars = [...SITE.email];
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="cta__panel" data-cta data-email={SITE.email}>
    <HeadlineRunner />

    <h2 class="cta__headline text-display" id="cta-heading" data-runner-level>
      Let’s build <br class="desktop-only" />
      something real.
    </h2>

    <div class="cta__row">
      <p class="cta__email">
        <span class="text-mono">DROP A LINE</span>
        <a
          class="cta__email-link"
          href={`mailto:${SITE.email}`}
          aria-label={SITE.email}
          data-runner-email
        >
          <span class="cta__email-text" aria-hidden="true">
            {emailChars.map((char, i) => (
              <span class="cta__email-char" style={`--i:${i}`}>
                {char}
              </span>
            ))}
          </span>
        </a>
      </p>
      <div class="cta__finish" data-runner-finish>
        <Button label="Start a project" href="/contact/" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-inline: var(--panel-gutter);
  }

  .cta__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 1400px;
    margin-inline: auto;
    padding: var(--space-10) var(--space-6) var(--space-8);
    overflow: hidden;
    background-color: var(--color-bg);
    background-image: radial-gradient(
      ellipse 62.5% 71.43% at 25% 21.43%,
      #363636 0%,
      #202020 30%,
      #151515 50%,
      var(--color-bg) 70%
    );
    border-radius: var(--radius-panel);
    touch-action: manipulation; /* fast taps for the runner's jump */
  }

  .cta__headline {
    position: relative;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .cta__row {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    margin-block-start: 120px;
  }

  /* Wraps the button so the runner can measure it as the finish platform. */
  .cta__finish {
    display: flex;
  }

  .cta__email {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cta__email a {
    font-size: clamp(1.25rem, 6.15vw, var(--text-xl));
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-h3);
  }

  /* Underline drawn as a background so it can wipe out and back in on hover. */
  .cta__email-link {
    --roll: 1.3em; /* > line box + descenders, so the copy waits out of sight */

    display: inline-block;
    padding-block-end: 0.12em;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 0.06em no-repeat;
  }

  /* Clip window for the roll; padding keeps descenders (p, g) visible. */
  .cta__email-text {
    display: inline-block;
    padding-block-end: 0.08em;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
  }

  /* The copy is a text-shadow one roll below, so no duplicate text in the DOM. */
  .cta__email-char {
    display: inline-block;
    white-space: pre;
    text-shadow: 0 var(--roll) currentColor;
    transition: translate var(--duration-slow) var(--ease-in-out);
    transition-delay: calc(var(--i) * var(--duration-fast) / 12);
  }

  @keyframes cta-underline {
    0% {
      background-position: right bottom;
      background-size: 100% 0.06em;
    }

    45% {
      background-position: right bottom;
      background-size: 0 0.06em;
    }

    55% {
      background-position: left bottom;
      background-size: 0 0.06em;
    }

    100% {
      background-position: left bottom;
      background-size: 100% 0.06em;
    }
  }

  @media (hover: hover) {
    .cta__email-link:hover .cta__email-char {
      translate: 0 calc(var(--roll) * -1);
    }

    .cta__email-link:hover {
      animation: cta-underline calc(var(--duration-slow) * 2) var(--ease-in-out);
    }
  }

  /* Keyboard focus gets the same roll. */
  .cta__email-link:focus-visible .cta__email-char {
    translate: 0 calc(var(--roll) * -1);
  }

  @media (min-width: 48em) {
    .cta__panel {
      min-height: 760px;
      justify-content: space-between;
      padding: var(--space-18) var(--space-12) var(--space-16) var(--space-10);
      background-image: none;
    }

    /* Desktop: the gradient layer sits at 45% opacity in the design. */
    .cta__panel::before {
      position: absolute;
      inset: 0;
      content: '';
      background-image: radial-gradient(
        ellipse 83.33% 41.67% at -8.33% 20.83%,
        #363636 0%,
        #202020 30%,
        #151515 47.5%,
        var(--color-bg) 65%
      );
      opacity: 0.45;
    }

    .cta__headline {
      letter-spacing: var(--tracking-display);
      line-height: var(--leading-display);
    }

    .cta__row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      align-self: stretch;
      margin-block-start: var(--space-16);
      padding-inline-start: var(--space-2);
    }

    .cta__email a {
      font-size: var(--text-h2);
      line-height: var(--leading-tight);
      letter-spacing: var(--tracking-h2);
    }
  }
</style>
