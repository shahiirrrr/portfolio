---
/**
 * Document shell: <html>, <head> (SEO, fonts, favicon, global CSS) and <body>.
 * Has no visible chrome — use PageLayout for regular pages.
 */
import '@/styles/global.css';

import { Font } from 'astro:assets';

import Seo from '@/components/common/Seo.astro';
import { SITE } from '@/config/site';
import type { LayoutProps } from '@/types';

type Props = LayoutProps;

const { seo = {}, jsonLd = [] } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-manrope" preload={[{ weight: 600 }, { weight: 700 }]} />
    <Font cssVariable="--font-antonio" />
    <Font cssVariable="--font-unbounded" />
    <Seo seo={seo} jsonLd={jsonLd} />
    <!-- Marks JS as available so on-load intros can hide their start state
         (see `[data-intro]` in global.css). The timeout is a failsafe: content
         is shown even if the animation script never runs.
         Card transition (CLAUDE.md §13): when a Home card just navigated here,
         mark `card-enter` before the first paint so the page opens on the
         card's full-screen frame (CardStage); the key matches
         CARD_TRANSITION_KEY in card-stage.ts. The failsafe drops the frame if
         case-study-enter.ts never takes over. It also limits the browser's
         page transition (global.css) to that one navigation. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        try {
          var saved = sessionStorage.getItem('card-transition');
          if (saved) {
            sessionStorage.removeItem('card-transition');
            var data = JSON.parse(saved);
            var path = /^\/[\w\-./]+$/;
            if (
              data.path === location.pathname &&
              Date.now() - data.t < 8000 &&
              path.test(data.img) &&
              path.test(data.fallback) &&
              matchMedia('(prefers-reduced-motion: no-preference)').matches
            ) {
              html.classList.add('card-enter');
              html.dataset.cardStage = data.img;
              html.style.setProperty(
                '--card-stage-image',
                'url("' + data.img + '"), url("' + data.fallback + '")',
              );
              var preload = document.createElement('link');
              preload.rel = 'preload';
              preload.as = 'image';
              preload.href = data.img;
              preload.fetchPriority = 'high';
              document.head.appendChild(preload);
            }
          }
        } catch (error) {
          // Storage unavailable: normal page load.
        }
        // Page transitions: only the card → case study navigation keeps one
        // (global.css); everything else switches pages as normal.
        var isCardNavigation = function () {
          try {
            var pending = JSON.parse(sessionStorage.getItem('card-transition') || 'null');
            return Boolean(pending && Date.now() - pending.t < 8000);
          } catch (error) {
            return false;
          }
        };
        addEventListener('pageswap', function (event) {
          if (event.viewTransition && !isCardNavigation()) event.viewTransition.skipTransition();
        });
        addEventListener('pagereveal', function (event) {
          if (event.viewTransition && !html.classList.contains('card-enter')) {
            event.viewTransition.skipTransition();
          }
        });
        setTimeout(function () {
          html.classList.add('motion-ready');
          if (!html.classList.contains('card-entering')) html.classList.remove('card-enter');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
